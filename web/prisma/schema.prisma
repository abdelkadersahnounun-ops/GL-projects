generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  projects Project[]
  audioAssets AudioAsset[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Avatar / Background catalog (demo data now, pluggable providers later)
// ---------------------------------------------------------------------------

enum AvatarGender {
  MALE
  FEMALE
  NEUTRAL
}

model Avatar {
  id          String   @id @default(cuid())
  provider    String   @default("mock") // "mock" | "heygen" | "did" | "synthesia" ...
  externalId  String? // id in the external provider's catalog, if any
  name        String
  type        String // "realistic" | "illustrated" | "3d"
  style       String // "professional", "casual", "presenter", ...
  gender      AvatarGender
  language    String   @default("fr-FR")
  thumbnailKey String  // storage key of the compositing-ready cutout (PNG w/ alpha)
  thumbnailUrl String  // public URL for the same object, resolved via StorageProvider
  previewVideoUrl String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  projects Project[]

  @@map("avatars")
}

model Background {
  id          String   @id @default(cuid())
  name        String
  category    String // "studio" | "office" | "outdoor" | "abstract" | "solid"
  thumbnailKey String
  thumbnailUrl String
  assetKey    String? // storage key of the full-resolution plate (unused when kind = "color")
  assetUrl    String? // image or video used as background plate
  kind        String   @default("image") // "image" | "video" | "color"
  colorValue  String? // for kind = "color"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  projects Project[]

  @@map("backgrounds")
}

// ---------------------------------------------------------------------------
// Projects / Audio / Jobs / Videos
// ---------------------------------------------------------------------------

enum VoiceTransform {
  NONE
  FEMALE
  MALE
  ROBOT
  DEEP
  CHIPMUNK
}

model AudioAsset {
  id            String   @id @default(cuid())
  userId        String
  originalName  String
  storageKey    String // key/path in the storage provider
  url           String
  durationSec   Float?
  mimeType      String?
  sizeBytes     Int?

  voiceTransform      VoiceTransform @default(NONE)
  processedStorageKey String?
  processedUrl        String?
  processingStatus    String         @default("idle") // idle | processing | done | error

  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]

  @@map("audio_assets")
}

enum AspectRatio {
  LANDSCAPE_16_9
  PORTRAIT_9_16
  SQUARE_1_1
}

enum Resolution {
  R_720P
  R_1080P
  R_4K
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  status      String   @default("draft") // draft | queued | processing | completed | failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  avatarId     String?
  backgroundId String?
  audioAssetId String?

  // generation params
  aspectRatio AspectRatio @default(LANDSCAPE_16_9)
  resolution  Resolution  @default(R_1080P)
  subtitles   Boolean     @default(false)
  captionText String?
  variantCount Int        @default(1)
  avatarScale  Float      @default(1.0)
  avatarPositionX Float   @default(0.5)
  avatarPositionY Float   @default(0.85)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar     Avatar?     @relation(fields: [avatarId], references: [id])
  background Background? @relation(fields: [backgroundId], references: [id])
  audioAsset AudioAsset? @relation(fields: [audioAssetId], references: [id])

  jobs   VideoJob[]
  videos Video[]

  @@map("projects")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model VideoJob {
  id          String    @id @default(cuid())
  projectId   String
  status      JobStatus @default(PENDING)
  progress    Int       @default(0)
  stage       String    @default("queued") // queued | voice_conversion | rendering | encoding | done
  errorMessage String?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  video   Video?

  @@map("video_jobs")
}

model Video {
  id            String   @id @default(cuid())
  projectId     String
  jobId         String?  @unique
  storageKey    String
  url           String
  thumbnailUrl  String?
  durationSec   Float?
  sizeBytes     Int?
  resolution    Resolution
  aspectRatio   AspectRatio
  createdAt     DateTime @default(now())

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job     VideoJob? @relation(fields: [jobId], references: [id])

  @@map("videos")
}
