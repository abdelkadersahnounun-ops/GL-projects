# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://avatarstudio:avatarstudio@localhost:5432/avatarstudio?schema=public"

# --- Auth (Auth.js / NextAuth) ------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Storage --------------------------------------------------------------
# "local" stores files on disk under ./storage (default, works out of the box).
# "s3" enables AWS S3 / Cloudflare R2 / Supabase Storage (all S3-compatible).
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage"
STORAGE_PUBLIC_BASE_URL="/api/files"

# S3-compatible storage (used when STORAGE_PROVIDER="s3")
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT="" # e.g. https://<account-id>.r2.cloudflarestorage.com for R2
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL="" # public/CDN base URL for serving uploaded objects
S3_FORCE_PATH_STYLE="true"

# --- Avatar provider --------------------------------------------------
# "mock" ships a ready-to-use demo catalog. Swap in a real provider
# (HeyGen, D-ID, Synthesia...) by implementing AvatarProvider and switching
# this flag; no other application code needs to change.
AVATAR_PROVIDER="mock"

# --- Voice conversion provider -----------------------------------------
# "ffmpeg" performs a real, local pitch/formant based conversion (no external
# API key required). Swap for a neural voice-conversion API later.
VOICE_PROVIDER="ffmpeg"

# --- Video rendering provider --------------------------------------------
# "ffmpeg" renders real MP4s locally by compositing the avatar image, the
# background and the (optionally voice-converted) audio track. Swap in a
# real talking-avatar API (HeyGen, D-ID, Synthesia...) later.
VIDEO_PROVIDER="ffmpeg"

# --- Worker ---------------------------------------------------------------
WORKER_POLL_INTERVAL_MS="1500"
